# Database
DATABASE_URL="postgresql://sigo:sigo_secret_2026@localhost:5434/sigo_dental?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="cambia-esto-por-un-secret-muy-largo-y-seguro-en-produccion"
JWT_EXPIRES_IN="8h"

# MFA (RNF-05)
MFA_APP_NAME="SIGO-Dental"
MFA_ENFORCE=true
MFA_REQUIRED_ROLES=""

# MinIO / S3
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="sigo_minio"
S3_SECRET_KEY="sigo_minio_secret_2026"
S3_BUCKET="sigo-dental"
S3_REGION="us-east-1"
S3_AUTO_CREATE_BUCKET=true
S3_SSE=""

# Notifications (rellenar después)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
EMAIL_FROM="noreply@clinica.com"

# WhatsApp Business (Meta Cloud API)
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# Recordatorios
DISABLE_REMINDER_CRON=false

# Fiscal: sri-simulado (por defecto) | sri (real) | mock
FISCAL_PROVIDER=sri-simulado
