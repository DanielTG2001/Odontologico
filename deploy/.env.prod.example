# ===== Producción SIGO-Dental =====
DOMAIN=app.tu-clinica.ec
TLS_CERT_DIR=/etc/letsencrypt/live/app.tu-clinica.ec

POSTGRES_USER=sigo
POSTGRES_PASSWORD=<largo-y-aleatorio>
POSTGRES_DB=sigo_dental
# RNF-03: pool por réplica. 2 réplicas × 20 = 40 conexiones (postgres max_connections=200)
DATABASE_URL=postgresql://sigo:<password>@postgres:5432/sigo_dental?schema=public&connection_limit=20&pool_timeout=10

REDIS_PASSWORD=<largo-y-aleatorio>
REDIS_URL=redis://:<redis-password>@redis:6379

JWT_SECRET=<mínimo 32 caracteres aleatorios>
JWT_EXPIRES_IN=8h
MFA_ENFORCE=true
METRICS_TOKEN=<aleatorio>

S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=<usuario>
S3_SECRET_KEY=<clave>
S3_BUCKET=sigo-dental
S3_AUTO_CREATE_BUCKET=true
# MinIO necesita KMS para SSE; con AWS S3 / Azure usar AES256
S3_SSE=

# ---- Facturación electrónica SRI ----
# sri = real (requiere RUC autorizado + firma .p12). Mientras no los tengas: sri-simulado
FISCAL_PROVIDER=sri-simulado
SRI_AMBIENTE=1                 # 1 pruebas, 2 producción
SRI_RUC=
SRI_RAZON_SOCIAL=
SRI_NOMBRE_COMERCIAL=
SRI_DIR_MATRIZ=
SRI_DIR_ESTABLECIMIENTO=
SRI_ESTAB=001
SRI_PTO_EMI=001
SRI_OBLIGADO_CONTABILIDAD=NO
SRI_CONTRIBUYENTE_RIMPE=
SRI_IVA_CODIGO=0               # 0 = 0 % (servicios de salud); 4 = 15 %
SRI_IVA_TARIFA=0
SRI_CERT_PATH=/run/secrets/firma.p12
SRI_CERT_PASSWORD=

# ---- Pagos en línea ----
PAYMENTS_PROVIDER=payphone
PAYMENTS_ENABLED=payphone
PAYPHONE_TOKEN=
PAYPHONE_STORE_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Notificaciones ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

BACKUP_RETENTION_DAYS=14
BACKUP_ENCRYPTION_KEY=<aleatorio, guardarlo fuera del servidor>
