# nginx para SIGO-Dental. Variables: ${DOMAIN}. Certificados en /etc/nginx/certs/{fullchain,privkey}.pem
# (Let's Encrypt: certbot certonly --webroot o el certificado de la clínica)

upstream sigo_api {
    least_conn;
    # Docker DNS resuelve "api" a todas las réplicas; se reintenta en la otra si una falla
    server api:4000 max_fails=3 fail_timeout=10s;
    keepalive 64;
}

upstream sigo_web {
    least_conn;
    server web:3000 max_fails=3 fail_timeout=10s;
    keepalive 32;
}

# SECURITY_CHECKLIST: limitar fuerza bruta en login también en el borde
# Las redes internas (monitoreo, pruebas de carga desde staging) no se limitan en /api
geo $api_limited { default 1; 10.0.0.0/8 0; 172.16.0.0/12 0; 192.168.0.0/16 0; 127.0.0.1 0; }
map $api_limited $api_limit_key { 0 ""; 1 $binary_remote_addr; }
limit_req_zone $binary_remote_addr zone=login:10m rate=10r/m;
limit_req_zone $api_limit_key zone=api:10m rate=30r/s;

server {
    listen 80;
    server_name ${DOMAIN};
    location = /nginx-health { access_log off; return 200 "ok"; }
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};

    # RNF-04: solo TLS 1.3
    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    ssl_stapling on;
    ssl_stapling_verify on;

    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy "origin-when-cross-origin" always;   # requerido por Payphone
    add_header X-Frame-Options DENY always;

    client_max_body_size 26m;   # archivos de hasta 25 MB
    keepalive_timeout 65s;

    # RNF-01: compresión
    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types application/json application/javascript text/css text/plain image/svg+xml application/xml;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 3s;
    proxy_read_timeout 60s;
    # RNF-02: si una réplica falla o se está reiniciando, reintenta en la otra
    proxy_next_upstream error timeout http_502 http_503 http_504;
    proxy_next_upstream_tries 2;

    # Métricas solo desde la red interna (Prometheus)
    location /api/metrics { allow 10.0.0.0/8; allow 172.16.0.0/12; allow 192.168.0.0/16; deny all; proxy_pass http://sigo_api; }

    location = /api/auth/login { limit_req zone=login burst=5 nodelay; proxy_pass http://sigo_api; }

    location /api/ {
        limit_req zone=api burst=60 nodelay;
        proxy_pass http://sigo_api;
    }

    # PWA: el service worker siempre fresco
    location = /sw.js {
        proxy_pass http://sigo_web;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
    }

    location /_next/static/ {
        proxy_pass http://sigo_web;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location / {
        proxy_pass http://sigo_web;
    }
}
