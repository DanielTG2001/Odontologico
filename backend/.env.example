# Copia este archivo a .env y completa los valores. NUNCA subas .env al repositorio.
DATABASE_URL=postgresql://sigo:sigo_secret_2026@localhost:5434/sigo_dental?schema=public
JWT_SECRET=cambia-esto-por-un-secret-largo-y-aleatorio
JWT_EXPIRES_IN=8h
PORT=4000
FRONTEND_URL=http://localhost:3000

# Redis (rate limiting de login, revocación de tokens, lock del cron, caché)
REDIS_URL=redis://localhost:6379

# MFA obligatoria (RNF-05). En desarrollo puedes poner MFA_ENFORCE=false
MFA_ENFORCE=true
# Vacío = obligatoria para todos los roles. Ej: ODONTOLOGO,CAJERO
MFA_REQUIRED_ROLES=
MFA_APP_NAME=SIGO-Dental

# S3 / MinIO (radiografías, fotos, PDFs)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=sigo_minio
S3_SECRET_KEY=sigo_minio_secret_2026
S3_BUCKET=sigo-dental
S3_AUTO_CREATE_BUCKET=true
# RNF-04: AES256 en producción (S3/Azure). MinIO local sin KMS no lo soporta: déjalo vacío.
S3_SSE=

# RF-05: horas tras las cuales una nota SOEP queda bloqueada
CLINICAL_NOTE_LOCK_HOURS=24

# Twilio (WhatsApp/SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+10000000000

# Email SMTP (para Gmail usa una "contraseña de aplicación", no tu contraseña real)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SIGO-Dental <no-reply@tu-clinica.com>"

# Recordatorios
DISABLE_REMINDER_CRON=false

# ---- Facturación electrónica (SRI Ecuador) ----
# sri-simulado = flujo SRI completo sin firma ni conexión (por defecto)
# sri = real (requiere RUC autorizado y firma .p12) · mock = timbrado mínimo
FISCAL_PROVIDER=sri-simulado
SRI_AMBIENTE=1                  # 1 = pruebas (celcer) · 2 = producción (cel)
SRI_RUC=
SRI_RAZON_SOCIAL=
SRI_NOMBRE_COMERCIAL=
SRI_DIR_MATRIZ=
SRI_DIR_ESTABLECIMIENTO=
SRI_ESTAB=001
SRI_PTO_EMI=001
SRI_SECUENCIAL_INICIAL=1        # si migras desde otro sistema, el siguiente número libre
SRI_OBLIGADO_CONTABILIDAD=NO
SRI_CONTRIBUYENTE_ESPECIAL=
SRI_CONTRIBUYENTE_RIMPE=        # p. ej. CONTRIBUYENTE RÉGIMEN RIMPE
SRI_IVA_CODIGO=0                # 0 = 0 % (servicios de salud) · 4 = 15 %
SRI_IVA_TARIFA=0
SRI_CERT_PATH=./certs/firma.p12 # firma electrónica (Security Data, BCE, Uanataca…)
SRI_CERT_BASE64=                # alternativa a SRI_CERT_PATH
SRI_CERT_PASSWORD=

# ---- Pagos en línea ----
PAYMENTS_PROVIDER=mock          # mock | payphone | stripe
PAYMENTS_ENABLED=mock           # lista separada por comas
PAYPHONE_TOKEN=
PAYPHONE_STORE_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- RF-07 descuentos ----
DISCOUNT_AUTO_APPROVE_PERCENT=0 # hasta este % se aprueba solo
DISCOUNT_APPROVER_ROLES=ADMIN_TI,ODONTOLOGO,ESPECIALISTA

# ---- Rendimiento / monitoreo (RNF-01/02/03) ----
SLOW_REQUEST_MS=1500
SLOW_QUERY_MS=300
METRICS_TOKEN=
